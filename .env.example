# Application identity and safety
APP_ENV=development
IMOCHA_WRITE_ENABLED=false

# Local service routing
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
BACKEND_URLS=http://localhost:5001,http://localhost:5002

# Separate MongoDB instance/database for this project only
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=ailbuploading_new
MONGO_COLLECTION=counters
COUNTER_ID=local_development

# External integration
IMOCHA_BASE_URL=https://app.imocha.io

# New-project private key; never commit this file
RSA_PRIVATE_KEY_PATH=Backend/private_key.pem
